APP_NAME=Profit Pilot AI News
ENVIRONMENT=development
DATABASE_URL=sqlite:///backend/data/profit_pilot.db
REDIS_URL=redis://localhost:6379/0

# Comma-separated frontend origins allowed to call the FastAPI backend.
# For production, replace/add your Vercel URL, for example:
# CORS_ORIGINS=https://your-profit-pilot.vercel.app
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# LLM provider: stub, gemini, or deepseek.
# When gemini is selected and DEEPSEEK_API_KEY is configured, DeepSeek is used as fallback.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30

MARKET_DATA_PROVIDER=stub
NEWS_PROVIDER=stub
# For the free trial, set NEWS_PROVIDER=rss.
# Google News RSS is used as a free aggregation layer; individual publishers can be
# added later when their public feed/access terms permit it.
NEWS_RSS_FEEDS=https://news.google.com/rss/search?q=NSE+India+stocks&hl=en-IN&gl=IN&ceid=IN:en
# Optional JSON mapping used for lightweight title-based NSE symbol resolution.
# Example: {"RELIANCE":["Reliance Industries","Reliance"],"TCS":["Tata Consultancy Services","TCS"]}
NEWS_SYMBOL_KEYWORDS_JSON={}
NEWS_FETCH_TIMEOUT_SECONDS=10
NEWS_MAX_ITEMS_PER_FEED=50
NEWS_POLL_INTERVAL_SECONDS=300
NEWS_TRADE_QUANTITY=1

# Angel One SmartAPI placeholders. Keep empty until read-only market data is configured.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
ANGEL_EXCHANGE=NSE
# JSON mapping of internal symbols to Angel One symbol tokens, for example: {"SBIN-EQ":"3045"}
ANGEL_SYMBOL_TOKENS_JSON={}
